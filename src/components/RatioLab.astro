---
// Interactive: split a total into parts with a given ratio a : b (: c).
import '../styles/qlab.css';
---

<ratio-lab class="panel lab qlab">
  <div class="lab-head">
    <span class="tag">التقسيم بنسبة</span>
  </div>
  <svg viewBox="0 0 360 120" class="stage" role="img" aria-label="شريط مقسوم إلى أجزاء بنسبة معطاة"></svg>
  <div class="sliders">
    <label><span class="ltr">a = <b data-v="a">2</b></span><input type="range" data-k="a" min="1" max="9" value="2" dir="ltr" aria-label="a" /></label>
    <label><span class="ltr">b = <b data-v="b">3</b></span><input type="range" data-k="b" min="1" max="9" value="3" dir="ltr" aria-label="b" /></label>
    <label><span class="ltr">c = <b data-v="c">4</b></span><input type="range" data-k="c" min="0" max="9" value="4" dir="ltr" aria-label="c" /></label>
    <label><span class="ltr">T = <b data-v="T">180</b></span><input type="range" data-k="T" min="10" max="360" step="10" value="180" dir="ltr" aria-label="المجموع" /></label>
  </div>
  <div class="calc"></div>
  <p class="note"></p>
</ratio-lab>

<script>
  import { el, text } from '../scripts/svg';

  const fmt = (n: number) => String(Math.round(n * 100) / 100);

  class RatioLab extends HTMLElement {
    v: Record<string, number> = { a: 2, b: 3, c: 4, T: 180 };
    connectedCallback() {
      this.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((inp) =>
        inp.addEventListener('input', () => {
          this.v[inp.dataset.k!] = Number(inp.value);
          this.render();
        }),
      );
      this.render();
    }
    render() {
      const svg = this.querySelector('svg.stage')!;
      svg.replaceChildren();
      const { a, b, c, T } = this.v;
      const parts = c > 0 ? [a, b, c] : [a, b];
      const sum = parts.reduce((s, x) => s + x, 0);
      const x0 = 20;
      const W = 320;
      let x = x0;
      const unitW = W / sum;
      parts.forEach((p, i) => {
        const w = p * unitW;
        svg.appendChild(el('rect', { x, y: 30, width: w, height: 40, rx: 4 }, `part p${i}`));
        for (let j = 1; j < p; j++) svg.appendChild(el('line', { x1: x + j * unitW, y1: 30, x2: x + j * unitW, y2: 70 }, 'unit'));
        svg.appendChild(text(x + w / 2, 52, fmt((T * p) / sum), 'val'));
        svg.appendChild(text(x + w / 2, 92, `${p}x`, 'mlbl'));
        x += w;
      });
      svg.appendChild(text(180, 16, `${parts.join(' : ')}`, 'mlbl'));
      this.querySelectorAll<HTMLElement>('[data-v]').forEach((e) => (e.textContent = String(this.v[e.dataset.v!])));
      const xv = T / sum;
      this.querySelector('.calc')!.innerHTML =
        `<div>${parts.map((p) => `${p}x`).join(' + ')} = ${T}</div>` +
        `<div>${sum}x = ${T}  ⇒  x = ${fmt(xv)}</div>` +
        `<div class="big">${parts.map((p) => fmt(p * xv)).join(' , ')}</div>`;
      this.querySelector('.note')!.textContent =
        'كل جزء صغير في الشريط «وحدة» قيمتها x. عدد الوحدات كلها مجموع حدود النسبة، فنقسم المجموع عليه ثم نضرب. اجعل c = 0 لنسبة من حدّين.';
    }
  }
  customElements.define('ratio-lab', RatioLab);
</script>

<style is:global>
  ratio-lab .stage .part {
    stroke: var(--card);
    stroke-width: 2;
  }
  ratio-lab .stage .p0 { fill: var(--def-bg); stroke: var(--def); }
  ratio-lab .stage .p1 { fill: var(--thm-bg); stroke: var(--thm); }
  ratio-lab .stage .p2 { fill: var(--post-bg); stroke: var(--post); }
  ratio-lab .stage .unit {
    stroke: var(--ink-3);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  ratio-lab .stage .val {
    font-size: 13px;
  }
</style>
