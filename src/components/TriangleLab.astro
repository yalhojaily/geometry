---
// Interactive: drag a triangle's vertices. Live angle measures, the
// 180° strip (the three angles placed side by side), classification,
// and an optional exterior angle at C.
---

<triangle-lab class="panel lab">
  <div class="lab-head">
    <span class="tag">مختبر المثلث</span>
    <label class="ext"><input type="checkbox" class="extbox" /> أظهر الزاوية الخارجية عند C</label>
  </div>
  <svg viewBox="0 0 360 300" class="stage" role="img" aria-label="مثلث ABC قابل للسحب مع قياسات زواياه"></svg>
  <div class="tags">
    <span class="chip sides"></span>
    <span class="chip angles"></span>
  </div>
  <div class="calc ltr"></div>
  <p class="note"></p>
</triangle-lab>

<script>
  import { el, text, arcPath, polar, screenAngle, makeDraggable, type P } from '../scripts/svg';

  const U = 24;
  const OX = 24;
  const OY = 205;
  const XMAX = 13;
  const YMAX = 8;
  const px = (x: number) => OX + x * U;
  const py = (y: number) => OY - y * U;
  type K = 'A' | 'B' | 'C';

  function angleAt(V: P, Pp: P, Q: P): number {
    const a = Math.atan2(Pp.y - V.y, Pp.x - V.x);
    const b = Math.atan2(Q.y - V.y, Q.x - V.x);
    let d = Math.abs(a - b);
    if (d > Math.PI) d = 2 * Math.PI - d;
    return (d * 180) / Math.PI;
  }

  class TriangleLab extends HTMLElement {
    v: Record<K, P> = { A: { x: 4, y: 7 }, B: { x: 1, y: 1 }, C: { x: 11, y: 2 } };
    ext = false;
    drag!: { start: (k: K, e: PointerEvent) => void };

    connectedCallback() {
      const svg = this.querySelector<SVGSVGElement>('svg.stage')!;
      this.querySelector<HTMLInputElement>('.extbox')!.addEventListener('change', (e) => {
        this.ext = (e.target as HTMLInputElement).checked;
        this.render();
      });
      this.drag = makeDraggable<K>(svg, (k, p) => {
        const q = {
          x: Math.max(0, Math.min(XMAX, Math.round((p.x - OX) / U))),
          y: Math.max(0, Math.min(YMAX, Math.round((OY - p.y) / U))),
        };
        const o = (['A', 'B', 'C'] as K[]).filter((x) => x !== k).map((x) => this.v[x]);
        // keep a real triangle: no coincident or collinear vertices
        const cross = (o[0].x - q.x) * (o[1].y - q.y) - (o[0].y - q.y) * (o[1].x - q.x);
        if (cross === 0) return;
        if (this.v[k].x === q.x && this.v[k].y === q.y) return;
        this.v[k] = q;
        this.render();
      });
      this.render();
    }

    render() {
      const svg = this.querySelector('svg.stage')!;
      svg.replaceChildren();
      for (let x = 0; x <= XMAX; x++) svg.appendChild(el('line', { x1: px(x), y1: py(0), x2: px(x), y2: py(YMAX) }, 'gl'));
      for (let y = 0; y <= YMAX; y++) svg.appendChild(el('line', { x1: px(0), y1: py(y), x2: px(XMAX), y2: py(y) }, 'gl'));

      const S = (k: K) => ({ x: px(this.v[k].x), y: py(this.v[k].y) });
      const A = S('A');
      const B = S('B');
      const C = S('C');
      const raw = { A: angleAt(A, B, C), B: angleAt(B, A, C), C: angleAt(C, A, B) };
      const mA = Math.round(raw.A);
      const mB = Math.round(raw.B);
      const mC = 180 - mA - mB;

      // exterior angle at C (extend BC beyond C)
      if (this.ext) {
        const dirBC = screenAngle(B, C);
        const X = polar(C, 120, dirBC);
        svg.appendChild(el('line', { x1: C.x, y1: C.y, x2: X.x, y2: X.y }, 'extl'));
        const dirCA = screenAngle(C, A);
        const lo = dirBC;
        const sweep = (((dirCA - dirBC) % 360) + 360) % 360;
        const [s1, s2] = sweep <= 180 ? [lo, dirCA] : [dirCA, lo];
        svg.appendChild(el('path', { d: arcPath(C, 30, s1, s2, true) }, 'w wx'));
        const mid = polar(C, 46, s1 + ((((s2 - s1) % 360) + 360) % 360) / 2);
        svg.appendChild(text(mid.x, mid.y + 4, `∠1 = ${mA + mB}°`, 'wl wxl'));
      }

      const wedge = (V: P, Pp: P, Q: P, cls: string, m: number) => {
        const a1 = screenAngle(V, Pp);
        const a2 = screenAngle(V, Q);
        const sw = (((a2 - a1) % 360) + 360) % 360;
        const [s1, s2] = sw <= 180 ? [a1, a2] : [a2, a1];
        svg.appendChild(el('path', { d: arcPath(V, 22, s1, s2, true) }, `w ${cls}`));
        const mid = polar(V, 38, s1 + ((((s2 - s1) % 360) + 360) % 360) / 2);
        svg.appendChild(text(mid.x, mid.y + 4, `${m}°`, `wl ${cls}l`));
      };
      wedge(A, B, C, 'wa', mA);
      wedge(B, A, C, 'wb', mB);
      wedge(C, A, B, 'wc', mC);

      svg.appendChild(el('polygon', { points: `${A.x},${A.y} ${B.x},${B.y} ${C.x},${C.y}` }, 'tri'));
      (['A', 'B', 'C'] as K[]).forEach((k) => {
        const p = S(k);
        const g = el('g', {}, 'pt');
        g.appendChild(el('circle', { cx: p.x, cy: p.y, r: 15 }, 'hit'));
        g.appendChild(el('circle', { cx: p.x, cy: p.y, r: 6 }, 'dot'));
        const cx = (A.x + B.x + C.x) / 3;
        const cy = (A.y + B.y + C.y) / 3;
        const d = Math.hypot(p.x - cx, p.y - cy) || 1;
        g.appendChild(text(p.x + ((p.x - cx) / d) * 16 - 5, p.y + ((p.y - cy) / d) * 16 + 5, k, 'lbl'));
        g.addEventListener('pointerdown', (e) => this.drag.start(k, e as PointerEvent));
        svg.appendChild(g);
      });

      // the 180° strip: the three angles side by side
      const O = { x: 180, y: 285 };
      svg.appendChild(el('line', { x1: O.x - 80, y1: O.y, x2: O.x + 80, y2: O.y }, 'base'));
      const parts: [number, string][] = [
        [mA, 'wa'],
        [mB, 'wb'],
        [mC, 'wc'],
      ];
      let start = 0;
      for (const [m, cls] of parts) {
        if (m > 0) svg.appendChild(el('path', { d: arcPath(O, 58, start, start + m, true) }, `w ${cls} strip`));
        start += m;
      }
      svg.appendChild(text(O.x, O.y - 64, '180°', 'wl'));

      // classification
      const d2 = (p: P, q: P) => (p.x - q.x) ** 2 + (p.y - q.y) ** 2;
      const { A: a, B: b, C: c } = this.v;
      const sides = [d2(b, c), d2(a, c), d2(a, b)];
      const eqPairs = [sides[0] === sides[1], sides[1] === sides[2], sides[0] === sides[2]].filter(Boolean).length;
      const sideCls = eqPairs === 3 ? 'متطابق الأضلاع' : eqPairs >= 1 ? 'متطابق الضلعين' : 'مختلف الأضلاع';
      const dot = (V: P, Pp: P, Q: P) => (Pp.x - V.x) * (Q.x - V.x) + (Pp.y - V.y) * (Q.y - V.y);
      const dots = [dot(a, b, c), dot(b, a, c), dot(c, a, b)];
      const angCls = dots.some((x) => x === 0) ? 'قائم الزاوية' : dots.some((x) => x < 0) ? 'منفرج الزاوية' : 'حاد الزوايا';
      this.querySelector('.sides')!.textContent = `بالأضلاع: ${sideCls}`;
      this.querySelector('.angles')!.textContent = `بالزوايا: ${angCls}`;

      const calc = this.querySelector('.calc')!;
      calc.innerHTML =
        `<div>m∠A + m∠B + m∠C = ${mA}° + ${mB}° + ${mC}°</div><div>= <b>180°</b></div>` +
        (this.ext ? `<div class="x">m∠1 = m∠A + m∠B = ${mA}° + ${mB}° = <b>${mA + mB}°</b></div>` : '');
      const note = this.querySelector('.note')!;
      note.textContent = this.ext
        ? 'الزاوية الخارجية ∠1 عند C تساوي مجموع الزاويتين البعيدتين A و B، لأنها والزاوية C معًا 180°، كما أن A و B و C معًا 180°.'
        : 'المروحة في الأسفل تضع الزوايا الثلاث متجاورة: مهما غيّرت المثلث، تملأ نصف دائرة كاملًا.';
    }
  }
  customElements.define('triangle-lab', TriangleLab);
</script>

<style>
  .lab {
    display: block;
  }
  .lab-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .ext {
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
  }
  .ext input {
    accent-color: var(--brand);
  }
  .stage {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0.4rem auto;
    touch-action: none;
    background: var(--paper);
    border-radius: 10px;
  }
  .stage :global(.gl) {
    stroke: var(--line);
  }
  .stage :global(.tri) {
    fill: none;
    stroke: var(--brand);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .stage :global(.extl) {
    stroke: var(--ink-2);
    stroke-width: 2;
    stroke-dasharray: 6 4;
  }
  .stage :global(.w) {
    stroke: none;
  }
  .stage :global(.wa) {
    fill: var(--accent);
    fill-opacity: 0.55;
  }
  .stage :global(.wb) {
    fill: var(--thm);
    fill-opacity: 0.5;
  }
  .stage :global(.wc) {
    fill: var(--def);
    fill-opacity: 0.45;
  }
  .stage :global(.wx) {
    fill: var(--post);
    fill-opacity: 0.35;
  }
  .stage :global(.wl) {
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
  }
  .stage :global(.wxl) {
    fill: var(--post);
  }
  .stage :global(.base) {
    stroke: var(--ink-3);
    stroke-width: 1.5;
  }
  .stage :global(.pt) {
    cursor: grab;
  }
  .stage :global(.hit) {
    fill: transparent;
  }
  .stage :global(.dot) {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .stage :global(.lbl) {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 14px;
    fill: var(--ink);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
  }
  .chip {
    background: var(--def-bg);
    border-radius: 999px;
    padding: 0.1rem 0.8rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .calc {
    font-family: var(--font-head);
    font-size: 0.92rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.5rem 0.8rem;
    margin-top: 0.5rem;
    line-height: 1.7;
    text-align: left;
    overflow-x: auto;
  }
  .calc :global(div) {
    white-space: nowrap;
  }
  .calc :global(.x) {
    color: var(--post);
  }
  .note {
    margin: 0.5rem 0 0;
    padding: 0.5rem 0.8rem;
    border-radius: 10px;
    background: var(--paper-2);
    font-size: 0.95rem;
  }
</style>
