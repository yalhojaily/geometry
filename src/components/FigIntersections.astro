---
// Static figure: the three basic intersections.
---

<figure class="figs">
  <div class="cell">
    <svg viewBox="0 0 200 150" role="img" aria-label="مستقيمان يتقاطعان في نقطة">
      <line class="ln" x1="20" y1="125" x2="180" y2="25"></line>
      <line class="ln b" x1="20" y1="30" x2="180" y2="120"></line>
      <circle class="hit" cx="99.6" cy="75.2" r="6"></circle>
      <text x="96" y="104">P</text>
    </svg>
    <div class="cap">مستقيمان ← <b>نقطة</b></div>
  </div>
  <div class="cell">
    <svg viewBox="0 0 200 150" role="img" aria-label="مستويان يتقاطعان في مستقيم">
      <polygon class="pl b" points="60,82 140,82 140,140 60,140"></polygon>
      <polygon class="pl" points="15,115 145,115 185,50 55,50"></polygon>
      <polygon class="pl b" points="60,82 140,82 140,10 60,10"></polygon>
      <line class="cut" x1="60" y1="82" x2="140" y2="82"></line>
    </svg>
    <div class="cap">مستويان ← <b>مستقيم</b></div>
  </div>
  <div class="cell">
    <svg viewBox="0 0 200 150" role="img" aria-label="مستقيم يقطع مستوى في نقطة">
      <line class="ln dim" x1="100" y1="85" x2="82" y2="140"></line>
      <polygon class="pl" points="15,115 145,115 185,55 55,55"></polygon>
      <line class="ln" x1="100" y1="85" x2="125" y2="8"></line>
      <circle class="hit" cx="100" cy="85" r="6"></circle>
    </svg>
    <div class="cap">مستقيم ومستوى ← <b>نقطة</b></div>
  </div>
</figure>

<style>
  .figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.8rem;
    margin: 1.2rem 0;
  }
  .cell {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.5rem;
    text-align: center;
  }
  svg {
    width: 100%;
    max-width: 220px;
    display: block;
    margin: 0 auto;
  }
  .ln {
    stroke: var(--brand);
    stroke-width: 3;
  }
  .ln.b {
    stroke: var(--thm);
  }
  .ln.dim {
    stroke-dasharray: 5 5;
    opacity: 0.6;
  }
  .pl {
    fill: var(--def-bg);
    fill-opacity: 0.85;
    stroke: var(--def);
    stroke-width: 1.5;
  }
  .pl.b {
    fill: var(--thm-bg);
    stroke: var(--thm);
  }
  .cut {
    stroke: var(--accent);
    stroke-width: 4;
  }
  .hit {
    fill: var(--accent);
    stroke: var(--card);
    stroke-width: 2;
  }
  text {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15px;
    fill: var(--ink);
  }
  .cap {
    font-size: 0.92rem;
    color: var(--ink-2);
  }
</style>
