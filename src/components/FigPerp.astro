---
// Static figure: two perpendicular lines ℓ ⊥ m with the right-angle mark.
---

<figure class="fig">
  <svg viewBox="0 0 240 170" role="img" aria-label="مستقيمان متعامدان ℓ و m">
    <line x1="30" y1="120" x2="210" y2="60"></line>
    <line x1="100" y1="10" x2="140" y2="130" class="b"></line>
    <polyline class="sq" points="122.2,76.6 133.6,72.8 137.4,84.2"></polyline>
    <text x="214" y="58">ℓ</text>
    <text x="144" y="142" class="bt">m</text>
  </svg>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .fig {
    margin: 1rem 0;
    text-align: center;
  }
  svg {
    width: 100%;
    max-width: 260px;
    display: block;
    margin: 0 auto;
  }
  line {
    stroke: var(--brand);
    stroke-width: 3;
  }
  line.b {
    stroke: var(--thm);
  }
  .sq {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  text {
    font-family: var(--font-head);
    font-style: italic;
    font-size: 17px;
    font-weight: 700;
    fill: var(--brand);
  }
  .bt {
    fill: var(--thm);
  }
  figcaption {
    font-size: 0.9rem;
    color: var(--ink-3);
  }
</style>
