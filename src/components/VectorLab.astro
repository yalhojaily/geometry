---
// Interactive: two vectors on a grid, their magnitudes, directions and sum (head to tail).
import '../styles/qlab.css';
---

<vector-lab class="panel lab qlab">
  <div class="lab-head">
    <span class="tag">المتجهات وجمعها</span>
    <span class="hint-small">اسحب رأسي السهمين</span>
  </div>
  <svg viewBox="0 0 360 300" class="stage" role="img" aria-label="متجهان على شبكة ومجموعهما"></svg>
  <label class="tg"><input type="checkbox" class="sum" checked /> أظهر المجموع</label>
  <div class="calc"></div>
  <p class="note"></p>
</vector-lab>

<script>
  import { el, text, makeDraggable, type P } from '../scripts/svg';
  import { pts } from '../scripts/quad';

  const G = 24;
  const O = { x: 60, y: 250 };
  const px = (p: P): P => ({ x: O.x + p.x * G, y: O.y - p.y * G });
  const fmt = (n: number, d = 2) => {
    const r = Math.round(n * 10 ** d) / 10 ** d;
    return (Object.is(r, -0) ? 0 : r).toString().replace('-', '−');
  };
  const dir = (v: P) => {
    let a = (Math.atan2(v.y, v.x) * 180) / Math.PI;
    if (a < 0) a += 360;
    return a;
  };

  class VectorLab extends HTMLElement {
    u: P = { x: 5, y: 2 };
    v: P = { x: 2, y: 5 };
    drag!: { start: (k: string, e: PointerEvent) => void };
    connectedCallback() {
      const svg = this.querySelector<SVGSVGElement>('svg.stage')!;
      this.drag = makeDraggable<string>(svg, (k, p) => {
        const q = { x: Math.round((p.x - O.x) / G), y: Math.round((O.y - p.y) / G) };
        if (k === 'u') {
          const nu = { x: Math.max(-2, Math.min(11, q.x)), y: Math.max(-1, Math.min(9, q.y)) };
          if (nu.x === 0 && nu.y === 0) return;
          this.u = nu;
        } else {
          const nv = { x: q.x - this.u.x, y: q.y - this.u.y };
          const tip = { x: this.u.x + nv.x, y: this.u.y + nv.y };
          if (tip.x < -2 || tip.x > 12 || tip.y < -1 || tip.y > 10) return;
          if (nv.x === 0 && nv.y === 0) return;
          this.v = nv;
        }
        this.render();
      });
      this.querySelector('.sum')!.addEventListener('change', () => this.render());
      this.render();
    }
    arrow(svg: Element, a: P, b: P, cls: string) {
      const A = px(a);
      const B = px(b);
      const L = Math.hypot(B.x - A.x, B.y - A.y) || 1;
      const u = { x: (B.x - A.x) / L, y: (B.y - A.y) / L };
      const n = { x: -u.y, y: u.x };
      const tip = { x: B.x - u.x * 9, y: B.y - u.y * 9 };
      svg.appendChild(el('line', { x1: A.x, y1: A.y, x2: tip.x, y2: tip.y }, `vl ${cls}`));
      svg.appendChild(el('polygon', { points: pts([B, { x: tip.x + n.x * 6, y: tip.y + n.y * 6 }, { x: tip.x - n.x * 6, y: tip.y - n.y * 6 }]) }, `vh ${cls}`));
    }
    render() {
      const svg = this.querySelector('svg.stage')!;
      svg.replaceChildren();
      for (let i = -2; i <= 12; i++) {
        const a = px({ x: i, y: -2 });
        const b = px({ x: i, y: 11 });
        svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, i === 0 ? 'axis' : 'grid'));
      }
      for (let j = -2; j <= 11; j++) {
        const a = px({ x: -3, y: j });
        const b = px({ x: 13, y: j });
        svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, j === 0 ? 'axis' : 'grid'));
      }
      const { u, v } = this;
      const s = { x: u.x + v.x, y: u.y + v.y };
      const showSum = this.querySelector<HTMLInputElement>('.sum')!.checked;
      const o = { x: 0, y: 0 };
      if (showSum) {
        // ghost of the other order (parallelogram)
        this.arrow(svg, o, v, 'ghost');
        this.arrow(svg, v, s, 'ghost');
        this.arrow(svg, o, s, 'vs');
      }
      this.arrow(svg, o, u, 'vu');
      this.arrow(svg, u, s, 'vv');
      const lab = (p: P, t: string, cls: string) => {
        const q = px(p);
        svg.appendChild(text(q.x, q.y, t, cls));
      };
      lab({ x: u.x / 2 + 0.3, y: u.y / 2 - 0.5 }, 'u', 'vlab vu');
      lab({ x: u.x + v.x / 2 + 0.5, y: u.y + v.y / 2 }, 'v', 'vlab vv');
      if (showSum) lab({ x: s.x / 2 - 0.5, y: s.y / 2 + 0.4 }, 'u + v', 'vlab vs');
      for (const [p, k] of [
        [u, 'u'],
        [s, 'v'],
      ] as [P, string][]) {
        const q = px(p);
        const g = el('g', {}, 'pt');
        g.appendChild(el('circle', { cx: q.x, cy: q.y, r: 15 }, 'hit'));
        g.appendChild(el('circle', { cx: q.x, cy: q.y, r: 5 }, 'dot'));
        g.addEventListener('pointerdown', (e) => this.drag.start(k, e as PointerEvent));
        svg.appendChild(g);
      }
      const mag = (w: P) => Math.hypot(w.x, w.y);
      const row = (name: string, w: P) =>
        `<div>${name} = ⟨${fmt(w.x)}, ${fmt(w.y)}⟩ , |${name}| ≈ ${fmt(mag(w))} , θ ≈ ${fmt(dir(w), 1)}°</div>`;
      this.querySelector('.calc')!.innerHTML =
        row('u', u) + row('v', v) + (showSum ? `<div class="big">u + v = ⟨${fmt(u.x)} + ${fmt(v.x)}, ${fmt(u.y)} + ${fmt(v.y)}⟩ = ⟨${fmt(s.x)}, ${fmt(s.y)}⟩</div>` : '');
      this.querySelector('.note')!.textContent =
        'ضع بداية v عند نهاية u، فيمتد المجموع من بداية u إلى نهاية v. الأسهم الباهتة تبيّن الترتيب الآخر v ثم u: يصلان إلى النقطة نفسها، فالجمع إبدالي، والشكل متوازي أضلاع.';
    }
  }
  customElements.define('vector-lab', VectorLab);
</script>

<style is:global>
  vector-lab .stage .grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  vector-lab .stage .axis {
    stroke: var(--ink-3);
    stroke-width: 1.6;
  }
  vector-lab .stage .vl {
    stroke-width: 3;
    stroke-linecap: round;
  }
  vector-lab .stage .vh {
    stroke: none;
  }
  vector-lab .stage .vl.vu { stroke: var(--brand); }
  vector-lab .stage .vh.vu { fill: var(--brand); }
  vector-lab .stage .vl.vv { stroke: var(--accent); }
  vector-lab .stage .vh.vv { fill: var(--accent); }
  vector-lab .stage .vl.vs { stroke: var(--thm); stroke-dasharray: 7 4; }
  vector-lab .stage .vh.vs { fill: var(--thm); }
  vector-lab .stage .vl.ghost { stroke: var(--ink-3); stroke-opacity: 0.45; stroke-width: 2; }
  vector-lab .stage .vh.ghost { fill: var(--ink-3); fill-opacity: 0.45; }
  vector-lab .stage .vlab {
    font-family: var(--font-head);
    font-size: 14px;
    font-weight: 700;
    font-style: italic;
    text-anchor: middle;
    dominant-baseline: middle;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
  }
  vector-lab .stage text.vu { fill: var(--brand); }
  vector-lab .stage text.vv { fill: var(--accent); }
  vector-lab .stage text.vs { fill: var(--thm); }
  vector-lab .tg {
    font-size: 0.9rem;
    display: flex;
    gap: 0.35rem;
    align-items: center;
    cursor: pointer;
  }
  vector-lab .tg input {
    accent-color: var(--brand);
  }
</style>
