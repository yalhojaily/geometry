---
// Interactive: does a set of given parts pin down ONE triangle?
// For each criterion we fix some parts on a base AB and draw the loci
// (circles for given lengths, rays for given angles). Where they meet
// is where the third vertex can go: one place → a congruence criterion.
interface Props {
  modes: ('SSS' | 'SAS' | 'ASA' | 'AAS' | 'SSA' | 'AAA' | 'HL')[];
}
const { modes } = Astro.props;
const names: Record<string, string> = {
  SSS: 'SSS', SAS: 'SAS', ASA: 'ASA', AAS: 'AAS', SSA: 'SSA', AAA: 'AAA', HL: 'HL',
};
---

<criteria-lab class="panel lab" data-modes={modes.join(',')}>
  <div class="lab-head">
    <span class="tag">هل تكفي هذه الأجزاء؟</span>
  </div>
  <div class="modes" role="tablist">
    {modes.map((m, i) => <button type="button" data-m={m} class:list={{ on: i === 0 }}>{names[m]}</button>)}
  </div>
  <p class="given"></p>
  <svg viewBox="0 0 360 240" class="stage" role="img" aria-label="إنشاء مثلث من أجزاء معطاة"></svg>
  <label class="slider">
    <span class="sl-label"></span>
    <input type="range" dir="ltr" aria-label="غيّر الجزء المعطى" />
  </label>
  <p class="verdict" aria-live="polite"></p>
</criteria-lab>

<script>
  import { el, text, polar, type P } from '../scripts/svg';

  type Mode = 'SSS' | 'SAS' | 'ASA' | 'AAS' | 'SSA' | 'AAA' | 'HL';
  const A: P = { x: 60, y: 205 };
  const B: P = { x: 260, y: 205 };
  const AB = 200;

  const CONF: Record<Mode, { label: string; min: number; max: number; val: number; given: string; unit: string }> = {
    SSS: { label: 'BC', min: 40, max: 380, val: 170, unit: '', given: 'معطى: AB = 200 و AC = 150، وطول BC يحدده المؤشر. حيث تلتقي الدائرتان يقع الرأس C.' },
    SAS: { label: 'm∠A', min: 15, max: 165, val: 55, unit: '°', given: 'معطى: AB = 200 و AC = 150 والزاوية المحصورة بينهما ∠A.' },
    ASA: { label: 'm∠B', min: 10, max: 85, val: 60, unit: '°', given: 'معطى: m∠A = 50° و AB = 200 و m∠B يحدده المؤشر. حيث يلتقي الشعاعان يقع C.' },
    AAS: { label: 'BC', min: 60, max: 200, val: 140, unit: '', given: 'معطى: m∠A = 50° و m∠B = 65°، والضلع BC غير المحصور بينهما.' },
    SSA: { label: 'BC', min: 60, max: 260, val: 130, unit: '', given: 'معطى: AB = 200 و m∠A = 35°، والضلع BC المقابل للزاوية (ليس محصورًا).' },
    AAA: { label: 'المقياس', min: 40, max: 100, val: 100, unit: '%', given: 'معطى: الزوايا الثلاث فقط: 50° و 65° و 65°، دون أي طول.' },
    HL: { label: 'الوتر AB', min: 130, max: 200, val: 170, unit: '', given: 'معطى: الزاوية C قائمة، والساق AC = 120، والوتر AB يحدده المؤشر.' },
  };

  /** Intersections of circle (c, r) with ray from o in direction deg (screen-CCW). */
  function rayCircle(o: P, deg: number, c: P, r: number): P[] {
    const t = (deg * Math.PI) / 180;
    const d = { x: Math.cos(t), y: -Math.sin(t) };
    const f = { x: o.x - c.x, y: o.y - c.y };
    const b = 2 * (f.x * d.x + f.y * d.y);
    const cc = f.x * f.x + f.y * f.y - r * r;
    const disc = b * b - 4 * cc;
    if (disc < 0) return [];
    const s = Math.sqrt(disc);
    return [(-b - s) / 2, (-b + s) / 2]
      .filter((k, i, arr) => k > 1e-6 && (i === 0 || Math.abs(k - arr[0]) > 0.5))
      .map((k) => ({ x: o.x + k * d.x, y: o.y + k * d.y }));
  }

  class CriteriaLab extends HTMLElement {
    mode: Mode = 'SSS';
    vals: Partial<Record<Mode, number>> = {};

    connectedCallback() {
      this.mode = (this.dataset.modes ?? 'SSS').split(',')[0] as Mode;
      this.querySelectorAll<HTMLButtonElement>('.modes button').forEach((b) =>
        b.addEventListener('click', () => {
          this.mode = b.dataset.m as Mode;
          this.querySelectorAll('.modes button').forEach((x) => x.classList.toggle('on', x === b));
          this.setup();
        }),
      );
      const range = this.querySelector<HTMLInputElement>('input')!;
      range.addEventListener('input', () => {
        this.vals[this.mode] = Number(range.value);
        this.render();
      });
      this.setup();
    }

    setup() {
      const c = CONF[this.mode];
      const range = this.querySelector<HTMLInputElement>('input')!;
      range.min = String(c.min);
      range.max = String(c.max);
      range.value = String(this.vals[this.mode] ?? c.val);
      this.querySelector('.given')!.textContent = c.given;
      this.render();
    }

    render() {
      const svg = this.querySelector('svg.stage')!;
      svg.replaceChildren();
      const c = CONF[this.mode];
      const v = this.vals[this.mode] ?? c.val;
      this.querySelector('.sl-label')!.textContent = `${c.label} = ${v}${c.unit}`;

      const circle = (o: P, r: number) => svg.appendChild(el('circle', { cx: o.x, cy: o.y, r }, 'locus'));
      const ray = (o: P, deg: number) => {
        const e = polar(o, 400, deg);
        svg.appendChild(el('line', { x1: o.x, y1: o.y, x2: e.x, y2: e.y }, 'locus'));
      };
      const tri = (a: P, b: P, cc: P, cls: string) =>
        svg.appendChild(el('polygon', { points: `${a.x},${a.y} ${b.x},${b.y} ${cc.x},${cc.y}` }, `tri ${cls}`));
      const dot = (p: P, label: string, cls = '') => {
        svg.appendChild(el('circle', { cx: p.x, cy: p.y, r: 5 }, `vx ${cls}`));
        svg.appendChild(text(p.x + 7, p.y - 7, label, `lbl ${cls}`));
      };
      const base = (a = A, b = B) => {
        svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, 'base'));
        dot(a, 'A');
        dot(b, 'B');
      };

      let sols: P[][] = []; // each solution: [A, B, C]
      let verdict = '';
      let ok = false;

      switch (this.mode) {
        case 'SSS': {
          base();
          circle(A, 150);
          circle(B, v);
          sols = rayCircleSSS(A, B, 150, v);
          ok = true;
          verdict = sols.length
            ? 'الدائرتان تلتقيان فوق القاعدة في نقطة واحدة فقط، فهناك مثلث واحد بهذه الأضلاع. (النقطة المقابلة تحت القاعدة تعطي المثلث نفسه مقلوبًا.) SSS معيار تطابق.'
            : 'الدائرتان لا تلتقيان: لا يوجد مثلث بهذه الأطوال. مجموع أي ضلعين يجب أن يزيد على الثالث (الدرس 5.5).';
          break;
        }
        case 'SAS': {
          base();
          ray(A, v);
          circle(A, 150);
          sols = [[A, B, polar(A, 150, v)]];
          ok = true;
          verdict = 'الشعاع والدائرة يلتقيان في نقطة واحدة دائمًا. الزاوية المحصورة وضلعاها تحدد مثلثًا واحدًا. SAS معيار تطابق.';
          break;
        }
        case 'ASA': {
          base();
          ray(A, 50);
          ray(B, 180 - v);
          ok = true;
          if (50 + v < 180) {
            // intersection of the two rays (law of sines)
            const C = 180 - 50 - v;
            const AC = (AB * Math.sin((v * Math.PI) / 180)) / Math.sin((C * Math.PI) / 180);
            sols = [[A, B, polar(A, AC, 50)]];
            verdict = 'الشعاعان يلتقيان في نقطة واحدة، فالمثلث محدد تمامًا. ASA معيار تطابق.';
          } else verdict = 'مجموع الزاويتين 180° أو أكثر: الشعاعان لا يلتقيان، فلا يوجد مثلث.';
          break;
        }
        case 'AAS': {
          // angles fixed → shape fixed; BC = v picks the size
          const angA = 50;
          const angB = 65;
          const angC = 180 - angA - angB;
          const sinr = (d: number) => Math.sin((d * Math.PI) / 180);
          const make = (bc: number): P[] => {
            const ab = (bc * sinr(angC)) / sinr(angA);
            const ac = (bc * sinr(angB)) / sinr(angA);
            const b = { x: A.x + ab, y: A.y };
            return [A, b, polar(A, ac, angA)];
          };
          for (const bc of [80, 120, 160, 200]) {
            const [a, b, cc] = make(bc);
            svg.appendChild(el('polygon', { points: `${a.x},${a.y} ${b.x},${b.y} ${cc.x},${cc.y}` }, 'ghost'));
          }
          const s = make(v);
          sols = [s];
          dot(A, 'A');
          ok = true;
          verdict = 'الزاويتان تحددان شكل المثلث (المثلثات الباهتة كلها بالشكل نفسه)، والضلع BC يختار حجمًا واحدًا منها. AAS معيار تطابق.';
          break;
        }
        case 'SSA': {
          base();
          ray(A, 35);
          circle(B, v);
          const pts = rayCircle(A, 35, B, v);
          sols = pts.map((p) => [A, B, p]);
          ok = false;
          verdict =
            pts.length === 2
              ? 'الدائرة تقطع الشعاع في نقطتين، فهناك مثلثان مختلفان بالأجزاء المعطاة نفسها! لذلك SSA ليس معيار تطابق.'
              : pts.length === 1
                ? 'هنا نقطة واحدة فقط، لكن غيّر BC قليلًا وسيظهر مثلثان. لأن SSA لا يضمن مثلثًا واحدًا دائمًا، فهو ليس معيار تطابق.'
                : 'الدائرة لا تصل إلى الشعاع: لا يوجد مثلث. حرّك المؤشر.';
          break;
        }
        case 'AAA': {
          const k = v / 100;
          const angA = 50;
          const angB = 65;
          const sinr = (d: number) => Math.sin((d * Math.PI) / 180);
          const ab = 200 * k;
          const ac = (ab * sinr(angB)) / sinr(180 - angA - angB);
          const b = { x: A.x + ab, y: A.y };
          const full = [A, { x: A.x + 200, y: A.y }, polar(A, (200 * sinr(angB)) / sinr(65), angA)];
          svg.appendChild(el('polygon', { points: full.map((p) => `${p.x},${p.y}`).join(' ') }, 'ghost'));
          sols = [[A, b, polar(A, ac, angA)]];
          dot(A, 'A');
          ok = false;
          verdict = 'كل هذه المثلثات لها الزوايا نفسها لكن أحجامها مختلفة. الزوايا وحدها تحدد الشكل لا الحجم، فـ AAA ليس معيار تطابق (لكنه معيار تشابه، الفصل 8).';
          break;
        }
        case 'HL': {
          const C: P = { x: 180, y: 205 };
          const Ap: P = { x: 180, y: 85 }; // AC = 120, vertical leg
          svg.appendChild(el('line', { x1: 20, y1: 205, x2: 340, y2: 205 }, 'locus'));
          svg.appendChild(el('line', { x1: C.x, y1: C.y, x2: Ap.x, y2: Ap.y }, 'base'));
          svg.appendChild(
            el('polyline', { points: `${C.x + 10},${C.y} ${C.x + 10},${C.y - 10} ${C.x},${C.y - 10}` }, 'sq'),
          );
          circle(Ap, v);
          const half = Math.sqrt(Math.max(0, v * v - 120 * 120));
          const B1 = { x: C.x + half, y: C.y };
          const B2 = { x: C.x - half, y: C.y };
          sols = [
            [Ap, B1, C],
            [Ap, B2, C],
          ];
          dot(Ap, 'A');
          dot(C, 'C');
          ok = true;
          verdict = 'الدائرة (الوتر) تقطع الخط الأفقي في نقطتين متناظرتين، والمثلثان صورتان مرآتيتان متطابقتان. فالوتر وساق يحددان المثلث القائم. HL معيار تطابق للمثلثات القائمة فقط.';
          break;
        }
      }

      sols.forEach((s, i) => {
        tri(s[0], s[1], s[2], `s${i}`);
        if (this.mode === 'HL') dot(s[1], i ? "B'" : 'B', `c${i}`);
        else dot(s[2], i ? "C'" : 'C', `c${i}`);
        if (this.mode === 'AAS' || this.mode === 'AAA') dot(s[1], 'B');
      });

      const ver = this.querySelector<HTMLElement>('.verdict')!;
      ver.textContent = verdict;
      ver.className = `verdict ${ok ? 'yes' : 'no'}`;
    }
  }

  /** SSS: C above AB with AC = b and BC = a. */
  function rayCircleSSS(a: P, b: P, ac: number, bc: number): P[][] {
    const d = b.x - a.x;
    const x = (ac * ac - bc * bc + d * d) / (2 * d);
    const h2 = ac * ac - x * x;
    if (h2 <= 0) return [];
    return [[a, b, { x: a.x + x, y: a.y - Math.sqrt(h2) }]];
  }

  customElements.define('criteria-lab', CriteriaLab);
</script>

<style>
  .lab {
    display: block;
  }
  .tag {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--accent-ink);
  }
  .modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.5rem 0;
  }
  .modes button {
    border: 1.5px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    border-radius: 10px;
    padding: 0.2rem 0.75rem;
    font-family: var(--font-head);
    font-weight: 600;
    direction: ltr;
  }
  .modes button.on {
    border-color: var(--brand);
    background: var(--def-bg);
  }
  .given {
    font-size: 0.93rem;
    color: var(--ink-2);
    margin: 0 0 0.3rem;
  }
  .stage {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0.3rem auto;
    background: var(--paper);
    border-radius: 10px;
  }
  .stage :global(.locus) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
  }
  .stage :global(.base) {
    stroke: var(--ink);
    stroke-width: 3;
  }
  .stage :global(.sq) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .stage :global(.tri) {
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .stage :global(.tri.s0) {
    fill: var(--brand);
    fill-opacity: 0.18;
    stroke: var(--brand);
  }
  .stage :global(.tri.s1) {
    fill: var(--accent);
    fill-opacity: 0.25;
    stroke: var(--accent);
  }
  .stage :global(.ghost) {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .stage :global(.vx) {
    fill: var(--ink);
  }
  .stage :global(.vx.c1) {
    fill: var(--accent);
  }
  .stage :global(.lbl) {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 13px;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
  }
  .stage :global(.lbl.c1) {
    fill: var(--accent);
  }
  .slider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .sl-label {
    flex: none;
    min-width: 7rem;
    font-family: var(--font-head);
    direction: ltr;
    text-align: start;
  }
  .slider input {
    flex: 1;
    accent-color: var(--brand);
  }
  .verdict {
    margin: 0.5rem 0 0;
    padding: 0.5rem 0.8rem;
    border-radius: 10px;
    font-size: 0.95rem;
  }
  .verdict.yes {
    background: var(--thm-bg);
  }
  .verdict.no {
    background: var(--warn-bg);
  }
</style>
