---
// Interactive: the two special right triangles with their side ratios.
import '../styles/qlab.css';
---

<special-lab class="panel lab qlab">
  <div class="lab-head">
    <span class="tag">المثلثان القائمان الخاصان</span>
  </div>
  <div class="modes" role="tablist">
    <button type="button" data-m="45" class="on"><span class="ltr">45°-45°-90°</span></button>
    <button type="button" data-m="30"><span class="ltr">30°-60°-90°</span></button>
  </div>
  <svg viewBox="0 0 360 240" class="stage" role="img" aria-label="مثلث قائم خاص وأطوال أضلاعه"></svg>
  <div class="sliders">
    <label><span class="ltr">x = <b class="xv">3</b></span><input type="range" class="x" min="1" max="8" value="3" dir="ltr" aria-label="x" /></label>
  </div>
  <div class="calc"></div>
  <p class="note"></p>
</special-lab>

<script>
  import { el, text, type P } from '../scripts/svg';
  import { pts, rightMark } from '../scripts/quad';

  const fmt = (n: number) => String(Math.round(n * 100) / 100);
  /** Write k·√r compactly, e.g. 3√2, √3, 2. */
  const rad = (k: number, r: number) => (r === 1 ? `${k}` : `${k === 1 ? '' : k}√${r}`);

  class SpecialLab extends HTMLElement {
    m = '45';
    x = 3;
    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('.modes button').forEach((b) =>
        b.addEventListener('click', () => {
          this.m = b.dataset.m!;
          this.querySelectorAll('.modes button').forEach((q) => q.classList.toggle('on', q === b));
          this.render();
        }),
      );
      const x = this.querySelector<HTMLInputElement>('input.x')!;
      x.addEventListener('input', () => {
        this.x = Number(x.value);
        this.render();
      });
      this.render();
    }
    render() {
      const svg = this.querySelector('svg.stage')!;
      svg.replaceChildren();
      const x = this.x;
      // legs in units; draw with a fixed size so the shape (not the number) is what you see
      const [w, h] = this.m === '45' ? [1, 1] : [Math.sqrt(3), 1];
      const s = Math.min(280 / w, 170 / h);
      const C: P = { x: 40, y: 210 };
      const B: P = { x: 40 + w * s, y: 210 };
      const A: P = { x: 40, y: 210 - h * s };
      svg.appendChild(el('polygon', { points: pts([A, B, C]) }, 'poly'));
      rightMark(svg, C, B, A, 12);
      const lab = (p: P, t: string, cls = 'mlbl') => svg.appendChild(text(p.x, p.y, t, cls));
      let hyp: string;
      let legs: [string, string];
      let calc: string;
      if (this.m === '45') {
        legs = [`${x}`, `${x}`];
        hyp = rad(x, 2);
        calc = `<div class="big">x√2 = ${x}√2 ≈ ${fmt(x * Math.SQRT2)}</div>`;
        lab({ x: B.x - 26, y: B.y - 10 }, '45°', 'val');
        lab({ x: A.x + 14, y: A.y + 30 }, '45°', 'val');
      } else {
        legs = [rad(x, 3), `${x}`];
        hyp = `${2 * x}`;
        calc =
          `<div class="big">2x = 2 × ${x} = ${2 * x}</div>` +
          `<div class="big">x√3 = ${rad(x, 3)} ≈ ${fmt(x * Math.sqrt(3))}</div>`;
        lab({ x: B.x - 34, y: B.y - 10 }, '30°', 'val');
        lab({ x: A.x + 14, y: A.y + 32 }, '60°', 'val');
      }
      lab({ x: (B.x + C.x) / 2, y: C.y + 18 }, legs[0]);
      lab({ x: C.x - 18, y: (A.y + C.y) / 2 }, legs[1]);
      lab({ x: (A.x + B.x) / 2 + 16, y: (A.y + B.y) / 2 - 12 }, hyp);
      this.querySelector('.xv')!.textContent = String(x);
      this.querySelector('.calc')!.innerHTML = calc;
      const L = (t: string) => `<span class="ltr">${t}</span>`;
      this.querySelector('.note')!.innerHTML =
        this.m === '45'
          ? `نصف مربع مقطوع بقطره. الساقان متساويتان، والوتر يساوي الساق مضروبة في ${L('√2')}. النسبة ${L('1 : 1 : √2')} ثابتة مهما كان ${L('x')}.`
          : `نصف مثلث متطابق الأضلاع. الوتر ضعف الساق القصرى، والساق الطولى تساوي القصرى مضروبة في ${L('√3')}. النسبة ${L('1 : √3 : 2')} ثابتة.`;
    }
  }
  customElements.define('special-lab', SpecialLab);
</script>
