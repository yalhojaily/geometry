---
import { termById, type TermKind } from '../data/terms';
import { renderMath } from '../data/math';

interface Props {
  id: string;
}

const t = termById[Astro.props.id];
if (!t) throw new Error(`Unknown term id: ${Astro.props.id}`);

const label: Record<TermKind, string> = {
  undefined: 'مصطلح غير معرَّف',
  definition: 'تعريف',
  postulate: 'مسلّمة',
  theorem: 'نظرية',
  formula: 'صيغة',
  law: 'قانون منطقي',
  property: 'خاصية',
  corollary: 'نتيجة',
};
---

<div class:list={['term', t.kind]} id={t.id}>
  <div class="head">
    <span class="kind">{label[t.kind]}</span>
    <span class="name">{t.ar}</span>
    <span class="en">{t.en}</span>
  </div>
  <p set:html={renderMath(t.statement)} />
  <slot />
</div>

<style>
  .term {
    --c: var(--def);
    --bg: var(--def-bg);
    --shape: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    background: var(--bg);
    border-inline-start: 4px solid var(--c);
    border-start-end-radius: 4px;
    border-end-end-radius: 4px;
    padding: 0.9rem 1.15rem;
    margin: 1.3rem 0;
    scroll-margin-top: 80px;
  }
  .term.undefined {
    --shape: circle(30%);
    --c: var(--ink-2);
    --bg: var(--paper-2);
  }
  .term.theorem {
    --shape: polygon(50% 0, 100% 100%, 0 100%);
    --c: var(--red);
    --bg: var(--red-bg);
  }
  .term.corollary {
    --shape: polygon(50% 0, 100% 100%, 0 100%);
    --c: var(--red);
    --bg: var(--card);
  }
  .term.law {
    --shape: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    --c: var(--brand);
    --bg: var(--paper-2);
  }
  .term.property {
    --shape: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    --c: var(--ink-2);
    --bg: var(--card);
  }
  .term.formula {
    --shape: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
    --c: var(--alg);
    --bg: var(--alg-bg);
  }
  .term.postulate {
    --shape: circle(50%);
    --c: var(--post);
    --bg: var(--post-bg);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  /* the kind is named and also drawn: square = definition, triangle = theorem, circle = postulate */
  .kind {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--c);
  }
  .kind::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    background: var(--c);
    clip-path: var(--shape);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }
  p {
    margin: 0;
  }
  .term :global(p + p) {
    margin-top: 0.5rem;
  }
</style>
