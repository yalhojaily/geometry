---
import { termById, type TermKind } from '../data/terms';
import { renderMath } from '../data/math';

interface Props {
  id: string;
}

const t = termById[Astro.props.id];
if (!t) throw new Error(`Unknown term id: ${Astro.props.id}`);

const label: Record<TermKind, string> = {
  undefined: 'مصطلح غير معرَّف',
  definition: 'تعريف',
  postulate: 'مسلّمة',
  theorem: 'نظرية',
};
---

<div class:list={['term', t.kind]} id={t.id}>
  <div class="head">
    <span class="kind">{label[t.kind]}</span>
    <span class="name">{t.ar}</span>
    <span class="en">{t.en}</span>
  </div>
  <p set:html={renderMath(t.statement)} />
  <slot />
</div>

<style>
  .term {
    --c: var(--def);
    --bg: var(--def-bg);
    background: var(--bg);
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    border-inline-start: 5px solid var(--c);
    border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
    margin: 1.2rem 0;
    scroll-margin-top: 80px;
  }
  .term.undefined {
    --c: var(--ink-2);
    --bg: var(--paper-2);
  }
  .term.theorem {
    --c: var(--thm);
    --bg: var(--thm-bg);
  }
  .term.postulate {
    --c: var(--post);
    --bg: var(--post-bg);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  .kind {
    font-family: var(--font-head);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--card);
    background: var(--c);
    border-radius: 6px;
    padding: 0.05rem 0.5rem;
  }
  .name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.1rem;
  }
  p {
    margin: 0;
  }
  .term :global(p + p) {
    margin-top: 0.5rem;
  }
</style>
