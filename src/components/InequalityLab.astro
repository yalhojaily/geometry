---
// Interactive inequalities in one triangle.
//  mode="order":  drag the vertices; sides and angles ranked by size,
//                 the same colour for a side and its opposite angle.
//  mode="sticks": three lengths; can they close into a triangle?
interface Props {
  mode: 'order' | 'sticks';
}
const { mode } = Astro.props;
---

<inequality-lab class="panel lab" data-mode={mode}>
  <div class="lab-head">
    <span class="tag">{mode === 'order' ? 'الضلع الأطول والزاوية الأكبر' : 'هل تُغلق العصي الثلاث؟'}</span>
  </div>
  <svg viewBox="0 0 360 250" class="stage" role="img" aria-label={mode === 'order' ? 'مثلث مرتبة أضلاعه وزواياه' : 'محاولة بناء مثلث من ثلاثة أطوال'}></svg>
  {
    mode === 'sticks' && (
      <div class="sliders">
        <label><span class="ltr">a = <b class="av">4</b></span><input type="range" class="a" min="1" max="9" value="4" dir="ltr" aria-label="a" /></label>
        <label><span class="ltr">b = <b class="bv">3</b></span><input type="range" class="b" min="1" max="9" value="3" dir="ltr" aria-label="b" /></label>
        <label><span class="ltr">c = <b class="cv">6</b></span><input type="range" class="c" min="1" max="9" value="6" dir="ltr" aria-label="c" /></label>
      </div>
    )
  }
  <div class="calc ltr"></div>
  <p class="note"></p>
</inequality-lab>

<script>
  import { el, text, makeDraggable, type P } from '../scripts/svg';

  type K = 'A' | 'B' | 'C';
  const RANK = ['small', 'mid', 'big'];
  const len = (a: P, b: P) => Math.hypot(a.x - b.x, a.y - b.y);
  function angleAt(V: P, Pp: P, Q: P): number {
    const u = { x: Pp.x - V.x, y: Pp.y - V.y };
    const w = { x: Q.x - V.x, y: Q.y - V.y };
    return (Math.acos((u.x * w.x + u.y * w.y) / (Math.hypot(u.x, u.y) * Math.hypot(w.x, w.y))) * 180) / Math.PI;
  }

  class InequalityLab extends HTMLElement {
    v: Record<K, P> = { A: { x: 110, y: 45 }, B: { x: 40, y: 220 }, C: { x: 320, y: 200 } };
    s = { a: 4, b: 3, c: 6 };
    drag!: { start: (k: K, e: PointerEvent) => void };

    connectedCallback() {
      if (this.dataset.mode === 'sticks') {
        for (const k of ['a', 'b', 'c'] as const) {
          const inp = this.querySelector<HTMLInputElement>(`input.${k}`)!;
          inp.addEventListener('input', () => {
            this.s[k] = Number(inp.value);
            this.render();
          });
        }
      } else {
        const svg = this.querySelector<SVGSVGElement>('svg.stage')!;
        this.drag = makeDraggable<K>(svg, (k, p) => {
          const q = { x: Math.max(15, Math.min(345, p.x)), y: Math.max(15, Math.min(235, p.y)) };
          const o = (['A', 'B', 'C'] as K[]).filter((x) => x !== k).map((x) => this.v[x]);
          const area = Math.abs((o[0].x - q.x) * (o[1].y - q.y) - (o[0].y - q.y) * (o[1].x - q.x)) / 2;
          if (area < 1200) return;
          this.v[k] = q;
          this.render();
        });
      }
      this.render();
    }

    render() {
      if (this.dataset.mode === 'sticks') this.renderSticks();
      else this.renderOrder();
    }

    renderOrder() {
      const svg = this.querySelector('svg.stage')!;
      svg.replaceChildren();
      const { A, B, C } = this.v;
      const V = [A, B, C];
      const names = ['A', 'B', 'C'];
      const sideNames = ['BC', 'CA', 'AB']; // side opposite each vertex
      const sides = [len(B, C), len(C, A), len(A, B)];
      const angs = [angleAt(A, B, C), angleAt(B, C, A), angleAt(C, A, B)];
      const order = [0, 1, 2].sort((i, j) => sides[i] - sides[j]); // ascending
      const rank = [0, 0, 0];
      order.forEach((i, r) => (rank[i] = r));

      // sides (opposite vertex i), coloured by rank
      V.forEach((_, i) => {
        const p = V[(i + 1) % 3];
        const q = V[(i + 2) % 3];
        svg.appendChild(el('line', { x1: p.x, y1: p.y, x2: q.x, y2: q.y }, `side ${RANK[rank[i]]}`));
      });
      // angle wedges at each vertex, same colour as the opposite side
      V.forEach((P0, i) => {
        const p = V[(i + 1) % 3];
        const q = V[(i + 2) % 3];
        const a1 = Math.atan2(p.y - P0.y, p.x - P0.x);
        const a2 = Math.atan2(q.y - P0.y, q.x - P0.x);
        let d = a2 - a1;
        while (d > Math.PI) d -= 2 * Math.PI;
        while (d < -Math.PI) d += 2 * Math.PI;
        const r = 26;
        const s1 = { x: P0.x + r * Math.cos(a1), y: P0.y + r * Math.sin(a1) };
        const s2 = { x: P0.x + r * Math.cos(a2), y: P0.y + r * Math.sin(a2) };
        svg.appendChild(
          el('path', { d: `M ${P0.x} ${P0.y} L ${s1.x} ${s1.y} A ${r} ${r} 0 0 ${d > 0 ? 1 : 0} ${s2.x} ${s2.y} Z` }, `w ${RANK[rank[i]]}`),
        );
        const am = a1 + d / 2;
        svg.appendChild(text(P0.x + 42 * Math.cos(am), P0.y + 42 * Math.sin(am) + 4, `${Math.round(angs[i])}°`, 'wl'));
      });

      (['A', 'B', 'C'] as K[]).forEach((k) => {
        const p = this.v[k];
        const g = el('g', {}, 'pt');
        g.appendChild(el('circle', { cx: p.x, cy: p.y, r: 15 }, 'hit'));
        g.appendChild(el('circle', { cx: p.x, cy: p.y, r: 6 }, 'dot'));
        const cx = (A.x + B.x + C.x) / 3;
        const cy = (A.y + B.y + C.y) / 3;
        const dd = Math.hypot(p.x - cx, p.y - cy) || 1;
        g.appendChild(text(p.x + ((p.x - cx) / dd) * 17 - 5, p.y + ((p.y - cy) / dd) * 17 + 5, k, 'lbl'));
        g.addEventListener('pointerdown', (e) => this.drag.start(k, e as PointerEvent));
        svg.appendChild(g);
      });

      const U = 40;
      const desc = [...order].reverse();
      this.querySelector('.calc')!.innerHTML =
        `<div>${desc.map((i) => `${sideNames[i]} = ${(sides[i] / U).toFixed(2)}`).join('  >  ')}</div>` +
        `<div>${desc.map((i) => `m∠${names[i]} = ${Math.round(angs[i])}°`).join('  >  ')}</div>`;
      this.querySelector('.note')!.textContent =
        'اللون نفسه للضلع والزاوية المقابلة له. ترتيب الأضلاع من الأطول إلى الأقصر هو دائمًا ترتيب الزوايا المقابلة من الأكبر إلى الأصغر.';
    }

    renderSticks() {
      const svg = this.querySelector('svg.stage')!;
      svg.replaceChildren();
      const { a, b, c } = this.s;
      for (const k of ['a', 'b', 'c'] as const) this.querySelector(`.${k}v`)!.textContent = String(this.s[k]);
      const U = 30;
      const A = { x: 180 - (c * U) / 2, y: 205 };
      const B = { x: 180 + (c * U) / 2, y: 205 };
      // C with AC = b, BC = a
      const x = (b * b - a * a + c * c) / (2 * c);
      const h2 = b * b - x * x;
      const ok = a + b > c && a + c > b && b + c > a;
      svg.appendChild(el('line', { x1: A.x, y1: A.y, x2: B.x, y2: B.y }, 'stick sc'));
      svg.appendChild(text((A.x + B.x) / 2, A.y + 20, `c = ${c}`, 'wl'));
      svg.appendChild(el('circle', { cx: A.x, cy: A.y, r: b * U }, 'locus'));
      svg.appendChild(el('circle', { cx: B.x, cy: B.y, r: a * U }, 'locus'));
      if (ok && h2 > 0) {
        const C = { x: A.x + x * U, y: A.y - Math.sqrt(h2) * U };
        svg.appendChild(el('line', { x1: A.x, y1: A.y, x2: C.x, y2: C.y }, 'stick sb'));
        svg.appendChild(el('line', { x1: B.x, y1: B.y, x2: C.x, y2: C.y }, 'stick sa'));
        svg.appendChild(el('circle', { cx: C.x, cy: C.y, r: 5 }, 'joint'));
      } else {
        // lay the two sticks along the base from each end, pointing upward as far as they can reach
        const tipB = { x: A.x + (b * U) * Math.cos(-Math.PI / 3), y: A.y + (b * U) * Math.sin(-Math.PI / 3) };
        const tipA = { x: B.x - (a * U) * Math.cos(-Math.PI / 3), y: B.y + (a * U) * Math.sin(-Math.PI / 3) };
        svg.appendChild(el('line', { x1: A.x, y1: A.y, x2: tipB.x, y2: tipB.y }, 'stick sb'));
        svg.appendChild(el('line', { x1: B.x, y1: B.y, x2: tipA.x, y2: tipA.y }, 'stick sa'));
      }
      for (const p of [A, B]) svg.appendChild(el('circle', { cx: p.x, cy: p.y, r: 5 }, 'joint'));

      const checks = [
        [a + b, c, 'a + b', 'c'],
        [a + c, b, 'a + c', 'b'],
        [b + c, a, 'b + c', 'a'],
      ] as [number, number, string, string][];
      this.querySelector('.calc')!.innerHTML = checks
        .map(([s, t, l, r]) => `<div class="${s > t ? 'ok' : 'no'}">${l} = ${s} ${s > t ? '>' : '≤'} ${r} = ${t}</div>`)
        .join('');
      this.querySelector('.note')!.textContent = ok
        ? 'الدائرتان تلتقيان، فالعصي الثلاث تصنع مثلثًا. كل مجموع لضلعين أكبر من الثالث.'
        : a + b === c || a + c === b || b + c === a
          ? 'المجموع يساوي الضلع الثالث بالضبط: العصوان تستلقيان على القاعدة فوق بعضهما، ولا يتكون مثلث.'
          : 'العصوان قصيرتان جدًا لتلتقيا. مجموع ضلعين يجب أن يكون أكبر من الثالث.';
    }
  }
  customElements.define('inequality-lab', InequalityLab);
</script>

<style>
  .lab {
    display: block;
  }
  .tag {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--accent);
  }
  .stage {
    display: block;
    width: 100%;
    max-width: 460px;
    margin: 0.4rem auto;
    touch-action: none;
    background: var(--paper);
    border-radius: 10px;
  }
  .stage :global(.side) {
    stroke-width: 4;
    stroke-linecap: round;
  }
  .stage :global(.side.big),
  .stage :global(.w.big) {
    stroke: var(--warn);
    fill: var(--warn);
  }
  .stage :global(.side.mid),
  .stage :global(.w.mid) {
    stroke: var(--accent);
    fill: var(--accent);
  }
  .stage :global(.side.small),
  .stage :global(.w.small) {
    stroke: var(--def);
    fill: var(--def);
  }
  .stage :global(.w) {
    stroke: none !important;
    fill-opacity: 0.4;
  }
  .stage :global(.wl) {
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
  }
  .stage :global(.lbl) {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15px;
    fill: var(--ink);
  }
  .stage :global(.locus) {
    fill: none;
    stroke: var(--ink-3);
    stroke-dasharray: 4 5;
  }
  .stage :global(.stick) {
    stroke-width: 6;
    stroke-linecap: round;
  }
  .stage :global(.sa) {
    stroke: var(--accent);
  }
  .stage :global(.sb) {
    stroke: var(--thm);
  }
  .stage :global(.sc) {
    stroke: var(--brand);
  }
  .stage :global(.joint) {
    fill: var(--ink);
  }
  .stage :global(.pt) {
    cursor: grab;
  }
  .stage :global(.hit) {
    fill: transparent;
  }
  .stage :global(.dot) {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .sliders {
    display: grid;
    gap: 0.25rem;
  }
  .sliders label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .sliders span {
    flex: none;
    width: 4rem;
    font-family: var(--font-head);
  }
  .sliders input {
    flex: 1;
    accent-color: var(--brand);
  }
  .calc {
    font-family: var(--font-head);
    font-size: 0.9rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.5rem 0.8rem;
    margin-top: 0.4rem;
    line-height: 1.7;
    text-align: left;
    overflow-x: auto;
  }
  .calc :global(div) {
    white-space: nowrap;
  }
  .calc :global(.ok) {
    color: var(--good);
  }
  .calc :global(.no) {
    color: var(--bad);
    font-weight: 700;
  }
  .note {
    margin: 0.5rem 0 0;
    padding: 0.5rem 0.8rem;
    border-radius: 10px;
    background: var(--paper-2);
    font-size: 0.95rem;
  }
</style>
