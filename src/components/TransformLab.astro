---
// Interactive coordinate-plane transformations of a triangle ABC.
// modes: reflect | rotate | translate | glide | stretch | compose
//  - stretch is a non-isometry, used for contrast in lesson 7.1
//  - compose: two reflections, in parallel lines (→ translation) or intersecting lines (→ rotation)
import '../styles/qlab.css';
interface Props {
  modes?: string[];
  lengths?: boolean;
  sub?: 'par' | 'int';
}
const { modes = ['reflect'], lengths = false, sub = 'par' } = Astro.props;
const NAMES: Record<string, string> = {
  reflect: 'انعكاس',
  rotate: 'دوران',
  translate: 'انسحاب',
  glide: 'انعكاس انزلاقي',
  stretch: 'تمديد',
  compose: 'انعكاسان',
};
---

<transform-lab class="panel lab qlab tlab" data-modes={modes.join(',')} data-lengths={lengths ? '1' : ''} data-sub={sub}>
  <div class="lab-head">
    <span class="tag">التحويلات في المستوى الإحداثي</span>
    <span class="hint-small">اسحب رؤوس الأصل</span>
  </div>
  {
    modes.length > 1 && (
      <div class="modes" role="tablist">
        {modes.map((m, i) => (
          <button type="button" data-m={m} class:list={{ on: i === 0 }}>
            {NAMES[m]}
          </button>
        ))}
      </div>
    )
  }
  <svg viewBox="0 0 360 360" class="stage" role="img" aria-label="مثلث وصورته بتحويل هندسي على مستوى إحداثي"></svg>
  <div class="ctrl"></div>
  <div class="calc"></div>
  <p class="note"></p>
</transform-lab>

<script>
  import { el, text, makeDraggable, type P } from '../scripts/svg';
  import { len, pts, centroid } from '../scripts/quad';

  const G = 26;
  const px = (p: P): P => ({ x: 180 + p.x * G, y: 180 - p.y * G });
  const fmt = (n: number) => {
    const r = Math.round(n * 100) / 100;
    const s = (Object.is(r, -0) ? 0 : r).toString();
    return s.replace('-', '−');
  };
  const sg = (n: number) => (n < 0 ? `− ${fmt(-n)}` : `+ ${fmt(n)}`);
  const fp = (p: P) => `(${fmt(p.x)}, ${fmt(p.y)})`;
  const rad = (d: number) => (d * Math.PI) / 180;
  const rot = (p: P, d: number): P => {
    const c = Math.cos(rad(d));
    const s = Math.sin(rad(d));
    return { x: p.x * c - p.y * s, y: p.x * s + p.y * c };
  };
  /** Reflection in the line through the origin making angle d with the x-axis. */
  const refl = (p: P, d: number): P => {
    const c = Math.cos(rad(2 * d));
    const s = Math.sin(rad(2 * d));
    return { x: p.x * c + p.y * s, y: p.x * s - p.y * c };
  };
  const LINES: Record<string, { label: string; ang: number; rule: string; name: string }> = {
    x: { label: 'محور x', ang: 0, rule: '(x, y) → (x, −y)', name: 'محور x' },
    y: { label: 'محور y', ang: 90, rule: '(x, y) → (−x, y)', name: 'محور y' },
    yx: { label: 'y = x', ang: 45, rule: '(x, y) → (y, x)', name: 'المستقيم y = x' },
    ynx: { label: 'y = −x', ang: 135, rule: '(x, y) → (−y, −x)', name: 'المستقيم y = −x' },
  };
  const ROT_RULES: Record<number, string> = {
    90: '(x, y) → (−y, x)',
    180: '(x, y) → (−x, −y)',
    270: '(x, y) → (y, −x)',
  };

  class TransformLab extends HTMLElement {
    pre: P[] = [{ x: 1, y: 1 }, { x: 4, y: 1 }, { x: 2, y: 4 }];
    m = 'reflect';
    line = 'y';
    angle = 90;
    a = -4;
    b = -3;
    ga = 4;
    sub = 'par';
    k1 = 1;
    k2 = 3;
    t1 = 0;
    t2 = 45;
    showLen = false;
    drag!: { start: (k: string, e: PointerEvent) => void };

    connectedCallback() {
      this.m = (this.dataset.modes ?? 'reflect').split(',')[0];
      this.showLen = !!this.dataset.lengths;
      this.sub = this.dataset.sub ?? 'par';
      if (this.sub === 'int') this.pre = [{ x: 3, y: -1 }, { x: 6, y: -1 }, { x: 4, y: -3 }];
      if (this.m === 'glide' || (this.m === 'compose' && this.sub === 'par')) this.pre = [{ x: -5, y: 1 }, { x: -2, y: 1 }, { x: -4, y: 3 }];
      this.querySelectorAll<HTMLButtonElement>('.modes button').forEach((b) =>
        b.addEventListener('click', () => {
          this.m = b.dataset.m!;
          this.querySelectorAll('.modes button').forEach((x) => x.classList.toggle('on', x === b));
          this.buildCtrl();
          this.render();
        }),
      );
      const svg = this.querySelector<SVGSVGElement>('svg.stage')!;
      this.drag = makeDraggable<string>(svg, (k, p) => {
        const i = Number(k);
        const q = {
          x: Math.max(-6, Math.min(6, Math.round((p.x - 180) / G))),
          y: Math.max(-6, Math.min(6, Math.round((180 - p.y) / G))),
        };
        const next = this.pre.slice();
        next[i] = q;
        const [A, B, C] = next;
        if (Math.abs((B.x - A.x) * (C.y - A.y) - (B.y - A.y) * (C.x - A.x)) < 1) return;
        if (q.x === this.pre[i].x && q.y === this.pre[i].y) return;
        this.pre = next;
        this.render();
      });
      this.buildCtrl();
      this.render();
    }

    buildCtrl() {
      const c = this.querySelector('.ctrl')!;
      const slider = (k: string, label: string, min: number, max: number, step: number, v: number, unit = '') =>
        `<label><span class="ltr">${label} = <b data-v="${k}">${v}</b>${unit}</span><input type="range" data-k="${k}" min="${min}" max="${max}" step="${step}" value="${v}" dir="ltr" aria-label="${label}" /></label>`;
      if (this.m === 'reflect') {
        c.innerHTML =
          `<div class="presets">` +
          Object.entries(LINES)
            .map(([k, l]) => `<button type="button" data-line="${k}" class="${k === this.line ? 'on' : ''}"><span class="ltr">${l.label}</span></button>`)
            .join('') +
          `</div>`;
      } else if (this.m === 'rotate') {
        c.innerHTML = `<div class="sliders">${slider('angle', '∠', 0, 345, 15, this.angle, '°')}</div>`;
      } else if (this.m === 'translate') {
        c.innerHTML = `<div class="sliders">${slider('a', 'a', -6, 6, 1, this.a)}${slider('b', 'b', -6, 6, 1, this.b)}</div>`;
      } else if (this.m === 'glide') {
        c.innerHTML = `<div class="sliders">${slider('ga', 'a', -6, 8, 1, this.ga)}</div>`;
      } else if (this.m === 'compose') {
        c.innerHTML =
          `<div class="presets"><button type="button" data-sub="par" class="${this.sub === 'par' ? 'on' : ''}">مستقيمان متوازيان</button>` +
          `<button type="button" data-sub="int" class="${this.sub === 'int' ? 'on' : ''}">مستقيمان متقاطعان</button></div>` +
          (this.sub === 'par'
            ? `<div class="sliders">${slider('k1', 'k: x', -4, 4, 1, this.k1)}${slider('k2', 'm: x', -4, 6, 1, this.k2)}</div>`
            : `<div class="sliders">${slider('t1', '∠k', 0, 165, 15, this.t1, '°')}${slider('t2', '∠m', 0, 165, 15, this.t2, '°')}</div>`);
      } else c.innerHTML = '';
      c.querySelectorAll<HTMLButtonElement>('[data-line]').forEach((b) =>
        b.addEventListener('click', () => {
          this.line = b.dataset.line!;
          c.querySelectorAll('[data-line]').forEach((x) => x.classList.toggle('on', x === b));
          this.render();
        }),
      );
      c.querySelectorAll<HTMLButtonElement>('[data-sub]').forEach((b) =>
        b.addEventListener('click', () => {
          this.sub = b.dataset.sub!;
          this.buildCtrl();
          this.render();
        }),
      );
      c.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((inp) =>
        inp.addEventListener('input', () => {
          (this as unknown as Record<string, number>)[inp.dataset.k!] = Number(inp.value);
          this.render();
        }),
      );
    }

    /** Draw an infinite line through math point p with direction angle d (degrees). */
    drawLine(svg: Element, p: P, d: number, cls: string, label?: string) {
      const u = { x: Math.cos(rad(d)), y: Math.sin(rad(d)) };
      const a = px({ x: p.x - u.x * 20, y: p.y - u.y * 20 });
      const b = px({ x: p.x + u.x * 20, y: p.y + u.y * 20 });
      svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, cls));
      if (label) {
        // place the label just inside the stage where the line leaves it (in direction u)
        const lim = 6.2;
        const ts = [
          u.x > 1e-6 ? (lim - p.x) / u.x : u.x < -1e-6 ? (-lim - p.x) / u.x : Infinity,
          u.y > 1e-6 ? (lim - p.y) / u.y : u.y < -1e-6 ? (-lim - p.y) / u.y : Infinity,
        ];
        const t = Math.min(...ts) - 0.5;
        const q = px({ x: p.x + u.x * t, y: p.y + u.y * t });
        svg.appendChild(text(q.x - u.y * 11, q.y - u.x * 11, label, 'mlbl'));
      }
    }

    arrow(svg: Element, p: P, q: P, cls: string) {
      const a = px(p);
      const b = px(q);
      const L = len(a, b);
      if (L < 4) return;
      const u = { x: (b.x - a.x) / L, y: (b.y - a.y) / L };
      const n = { x: -u.y, y: u.x };
      const tip = { x: b.x - u.x * 7, y: b.y - u.y * 7 };
      svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: tip.x, y2: tip.y }, cls));
      svg.appendChild(
        el('polygon', { points: pts([b, { x: tip.x - u.x * 2 + n.x * 5, y: tip.y - u.y * 2 + n.y * 5 }, { x: tip.x - u.x * 2 - n.x * 5, y: tip.y - u.y * 2 - n.y * 5 }]) }, cls + ' head'),
      );
    }

    tri(svg: Element, ps: P[], cls: string, names?: string[]) {
      const s = ps.map(px);
      svg.appendChild(el('polygon', { points: pts(s) }, cls));
      if (names) {
        const c = centroid(s);
        s.forEach((p, i) => {
          const d = len(p, c) || 1;
          svg.appendChild(text(p.x + ((p.x - c.x) / d) * 15, p.y + ((p.y - c.y) / d) * 15, names[i], cls === 'pre' ? 'lbl' : 'ilbl'));
        });
      }
    }

    render() {
      const svg = this.querySelector('svg.stage')!;
      svg.replaceChildren();
      for (let i = -6; i <= 6; i++) {
        const a = px({ x: i, y: -7 });
        const b = px({ x: i, y: 7 });
        svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, i === 0 ? 'axis' : 'grid'));
        const c = px({ x: -7, y: i });
        const d = px({ x: 7, y: i });
        svg.appendChild(el('line', { x1: c.x, y1: c.y, x2: d.x, y2: d.y }, i === 0 ? 'axis' : 'grid'));
      }
      svg.appendChild(text(348, 172, 'x', 'ax'));
      svg.appendChild(text(188, 14, 'y', 'ax'));
      this.querySelectorAll<HTMLElement>('[data-v]').forEach(
        (b) => (b.textContent = String((this as unknown as Record<string, number>)[b.dataset.v!])),
      );

      const pre = this.pre;
      let img: P[] = [];
      let mid: P[] | null = null;
      let rule = '';
      let note = '';
      const names = ['A', 'B', 'C'];
      const inames = ['A′', 'B′', 'C′'];
      const O = { x: 0, y: 0 };

      if (this.m === 'reflect') {
        const L = LINES[this.line];
        this.drawLine(svg, O, L.ang, 'mline');
        img = pre.map((p) => refl(p, L.ang));
        pre.forEach((p, i) => {
          const a = px(p);
          const b = px(img[i]);
          svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, 'help'));
        });
        rule = L.rule;
        note = `محور الانعكاس (${L.name}) هو العمود المنصف لكل قطعة متقطعة تصل نقطة بصورتها. لاحظ أن الصورة مقلوبة: السير من A إلى B إلى C في الأصل يكون مع عقارب الساعة أو عكسها، وفي الصورة يصير بالاتجاه المعاكس.`;
      } else if (this.m === 'rotate') {
        img = pre.map((p) => rot(p, this.angle));
        const a = px(pre[0]);
        const b = px(img[0]);
        const o = px(O);
        svg.appendChild(el('line', { x1: o.x, y1: o.y, x2: a.x, y2: a.y }, 'help'));
        svg.appendChild(el('line', { x1: o.x, y1: o.y, x2: b.x, y2: b.y }, 'help'));
        if (this.angle > 0) {
          const r = 28;
          const a0 = Math.atan2(pre[0].y, pre[0].x);
          const a1 = a0 + rad(this.angle);
          const p1 = { x: o.x + r * Math.cos(a0), y: o.y - r * Math.sin(a0) };
          const p2 = { x: o.x + r * Math.cos(a1), y: o.y - r * Math.sin(a1) };
          svg.appendChild(el('path', { d: `M ${p1.x} ${p1.y} A ${r} ${r} 0 ${this.angle > 180 ? 1 : 0} 0 ${p2.x} ${p2.y}` }, 'rarc'));
        }
        svg.appendChild(el('circle', { cx: o.x, cy: o.y, r: 4.5 }, 'ctr'));
        rule = ROT_RULES[this.angle] ?? `دوران بزاوية <span class="ltr">${this.angle}°</span> حول <span class="ltr">(0, 0)</span>`;
        note =
          'كل نقطة تدور حول نقطة الأصل بالزاوية نفسها، وتبقى على بعدها نفسه من المركز. والصورة غير مقلوبة: اتجاه الدوران من A إلى B إلى C محفوظ.';
      } else if (this.m === 'translate') {
        img = pre.map((p) => ({ x: p.x + this.a, y: p.y + this.b }));
        pre.forEach((p, i) => this.arrow(svg, p, img[i], 'vec'));
        rule = `(x, y) → (x ${sg(this.a)}, y ${sg(this.b)})  ,  ⟨${fmt(this.a)}, ${fmt(this.b)}⟩`;
        note = 'كل نقطة تتحرك بالمتجه نفسه: الأسهم الثلاثة متساوية ومتوازية. الصورة غير مقلوبة.';
      } else if (this.m === 'glide') {
        this.drawLine(svg, O, 0, 'mline');
        mid = pre.map((p) => ({ x: p.x + this.ga, y: p.y }));
        img = mid.map((p) => ({ x: p.x, y: -p.y }));
        pre.forEach((p, i) => this.arrow(svg, p, mid![i], 'vec'));
        mid.forEach((p, i) => {
          const a = px(p);
          const b = px(img[i]);
          svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, 'help'));
        });
        rule = `(x, y) → (x ${sg(this.ga)}, y) → (x ${sg(this.ga)}, −y)`;
        note = 'الخطوة 1: انسحاب موازٍ لمحور x (الشكل المتقطع). الخطوة 2: انعكاس في محور x. الانسحاب يوازي محور الانعكاس.';
      } else if (this.m === 'stretch') {
        img = pre.map((p) => ({ x: 1.5 * p.x, y: p.y }));
        pre.forEach((p, i) => {
          const a = px(p);
          const b = px(img[i]);
          svg.appendChild(el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y }, 'help'));
        });
        rule = '(x, y) → (1.5x, y)';
        note = 'هذا تحويل، لكنه لا يحافظ على الأطوال: الأضلاع تغيّرت، فالصورة ليست مطابقة للأصل. إذن ليس حركة صلبة.';
      } else if (this.m === 'compose') {
        if (this.sub === 'par') {
          this.drawLine(svg, { x: this.k1, y: 0 }, 90, 'mline', 'k');
          this.drawLine(svg, { x: this.k2, y: 0 }, 90, 'mline2', 'm');
          mid = pre.map((p) => ({ x: 2 * this.k1 - p.x, y: p.y }));
          img = mid.map((p) => ({ x: 2 * this.k2 - p.x, y: p.y }));
          const d = this.k2 - this.k1;
          this.arrow(svg, pre[0], img[0], 'vec');
          rule = `(x, y) → (x ${sg(2 * d)}, y)  ,  2 × ${fmt(Math.abs(d))} = ${fmt(Math.abs(2 * d))}`;
          note =
            d === 0
              ? 'المستقيمان منطبقان: الانعكاسان يلغي أحدهما الآخر، والصورة تعود إلى الأصل.'
              : `الانعكاس في k (المتقطع) ثم في m يساوي انسحابًا واحدًا (السهم) مسافته ضعف المسافة بين المستقيمين: ${fmt(Math.abs(2 * d))}.`;
        } else {
          this.drawLine(svg, O, this.t1, 'mline', 'k');
          this.drawLine(svg, O, this.t2, 'mline2', 'm');
          mid = pre.map((p) => refl(p, this.t1));
          img = mid.map((p) => refl(p, this.t2));
          const turn = (((2 * (this.t2 - this.t1)) % 360) + 360) % 360;
          let between = Math.abs(this.t2 - this.t1) % 180;
          if (between > 90) between = 180 - between;
          svg.appendChild(el('circle', { cx: 180, cy: 180, r: 4.5 }, 'ctr'));
          rule = `دوران حول <span class="ltr">(0, 0)</span> بزاوية <span class="ltr">${turn}°</span>`;
          note =
            between === 0
              ? 'المستقيمان منطبقان: الانعكاسان يلغي أحدهما الآخر.'
              : `الزاوية بين المستقيمين ${between}°. الانعكاس في k ثم في m يساوي دورانًا واحدًا حول نقطة التقاطع، بزاوية ضعف ${between}° (${2 * between}° في أحد الاتجاهين).`;
        }
      }

      if (mid) this.tri(svg, mid, 'midt');
      this.tri(svg, img, 'img', inames);
      this.tri(svg, pre, 'pre', names);
      pre.forEach((p, i) => {
        const s = px(p);
        const g = el('g', {}, 'pt');
        g.appendChild(el('circle', { cx: s.x, cy: s.y, r: 14 }, 'hit'));
        g.appendChild(el('circle', { cx: s.x, cy: s.y, r: 5 }, 'dot'));
        g.addEventListener('pointerdown', (e) => this.drag.start(String(i), e as PointerEvent));
        svg.appendChild(g);
      });

      let html = pre.map((p, i) => `<div>${names[i]}${fp(p)} → ${inames[i]}${fp(img[i])}</div>`).join('');
      html += /[\u0600-\u06FF]/.test(rule) ? `<div class="big" dir="rtl">${rule}</div>` : `<div class="big">${rule}</div>`;
      if (this.showLen) {
        const d0 = len(pre[0], pre[1]);
        const d1 = len(img[0], img[1]);
        const same = Math.abs(d0 - d1) < 0.01;
        html += `<div>AB = ${fmt(d0)} , A′B′ = ${fmt(d1)} ${same ? '✓' : '✗'}</div>`;
      }
      this.querySelector('.calc')!.innerHTML = html;
      this.querySelector('.note')!.textContent = note;
    }
  }
  customElements.define('transform-lab', TransformLab);
</script>

<style is:global>
  .tlab .stage .grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .tlab .stage .axis {
    stroke: var(--ink-3);
    stroke-width: 1.6;
  }
  .tlab .stage .ax {
    font-family: var(--font-head);
    font-size: 12px;
    font-style: italic;
    fill: var(--ink-3);
  }
  .tlab .stage .mline {
    stroke: var(--thm);
    stroke-width: 2.4;
  }
  .tlab .stage .mline2 {
    stroke: var(--post);
    stroke-width: 2.4;
  }
  .tlab .stage .help {
    stroke: var(--ink-3);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }
  .tlab .stage .vec {
    stroke: var(--post);
    stroke-width: 2;
  }
  .tlab .stage .vec.head {
    fill: var(--post);
    stroke: none;
  }
  .tlab .stage .rarc {
    fill: none;
    stroke: var(--post);
    stroke-width: 2;
  }
  .tlab .stage .ctr {
    fill: var(--post);
  }
  .tlab .stage .pre {
    fill: var(--brand);
    fill-opacity: 0.15;
    stroke: var(--brand);
    stroke-width: 2.6;
    stroke-linejoin: round;
  }
  .tlab .stage .img {
    fill: var(--accent);
    fill-opacity: 0.22;
    stroke: var(--accent);
    stroke-width: 2.6;
    stroke-linejoin: round;
  }
  .tlab .stage .midt {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.8;
    stroke-dasharray: 5 4;
  }
  .tlab .stage .ilbl {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 13px;
    fill: var(--accent);
    text-anchor: middle;
    dominant-baseline: middle;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
  }
  .tlab .stage .lbl {
    font-size: 13px;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 3px;
  }
  .tlab .stage .dot {
    stroke: var(--brand);
  }
  .tlab .presets button.on {
    border-color: var(--brand);
    background: var(--def-bg);
  }
  .tlab .modes {
    grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
  }
  .tlab .ctrl {
    margin-top: 0.3rem;
  }
</style>
