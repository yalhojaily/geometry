---
// Static figure: Eratosthenes' measurement. Parallel sun rays; the angle at
// Alexandria's stick equals the central angle (alternate interior angles).
const O = { x: 120, y: 195 };
const R = 110;
const rad = (d: number) => (d * Math.PI) / 180;
const pol = (r: number, d: number) => ({ x: O.x + r * Math.cos(rad(d)), y: O.y - r * Math.sin(rad(d)) });
const S = pol(R, 90); // Syene: sun straight overhead
const A = pol(R, 90 + 26); // Alexandria (angle exaggerated for visibility)
const Atop = pol(R + 34, 90 + 26);
const Stop = pol(R + 34, 90);
---

<figure class="fig">
  <svg viewBox="0 0 300 320" role="img" aria-label="أشعة الشمس المتوازية تصل إلى أسوان والإسكندرية، والزاوية عند عصا الإسكندرية تساوي الزاوية عند مركز الأرض">
    <circle cx={O.x} cy={O.y} r={R} class="earth"></circle>
    <line x1={O.x} y1={O.y} x2={Stop.x} y2={Stop.y} class="rad"></line>
    <line x1={O.x} y1={O.y} x2={Atop.x} y2={Atop.y} class="rad"></line>
    <line x1={S.x} y1={0} x2={S.x} y2={S.y} class="ray"></line>
    <line x1={Atop.x} y1={0} x2={Atop.x} y2={Atop.y} class="ray"></line>
    <line x1={S.x + 60} y1={0} x2={S.x + 60} y2={70} class="ray faint"></line>
    <path d={`M ${pol(26, 90).x} ${pol(26, 90).y} A 26 26 0 0 0 ${pol(26, 116).x} ${pol(26, 116).y}`} class="ang"></path>
    <path
      d={`M ${Atop.x} ${Atop.y - 26} A 26 26 0 0 0 ${Atop.x - 26 * Math.sin(rad(26))} ${Atop.y - 26 * Math.cos(rad(26))}`}
      class="ang"
    ></path>
    <circle cx={S.x} cy={S.y} r="4" class="city"></circle>
    <circle cx={A.x} cy={A.y} r="4" class="city"></circle>
    <text x={S.x + 32} y={S.y + 18}>أسوان</text>
    <text x={A.x - 18} y={A.y + 30}>الإسكندرية</text>
    <text x={O.x + 26} y={O.y + 18}>المركز</text>
    <text x={S.x + 100} y={40} class="sun">أشعة الشمس</text>
  </svg>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .fig {
    margin: 1rem 0;
    text-align: center;
  }
  svg {
    width: 100%;
    max-width: 320px;
    display: block;
    margin: 0 auto;
  }
  .earth {
    fill: var(--def-bg);
    stroke: var(--def);
    stroke-width: 2;
  }
  .rad {
    stroke: var(--ink-2);
    stroke-width: 1.8;
    stroke-dasharray: 5 4;
  }
  .ray {
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  .ray.faint {
    opacity: 0.5;
  }
  .ang {
    fill: none;
    stroke: var(--warn);
    stroke-width: 2.5;
  }
  .city {
    fill: var(--ink);
  }
  text {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    fill: var(--ink);
    direction: rtl;
    text-anchor: middle;
  }
  .sun {
    fill: var(--accent);
  }
  figcaption {
    font-size: 0.88rem;
    color: var(--ink-3);
  }
</style>
