---
import 'katex/dist/katex.min.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '@fontsource/reem-kufi/500.css';
import '@fontsource/reem-kufi/600.css';
import '@fontsource/reem-kufi/700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'شرح تفاعلي لمنهج الهندسة الإقليدية للثانوية والجامعة' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={`${base}/`}>
          <svg viewBox="0 0 40 32" width="40" height="32" aria-hidden="true">
            <circle cx="15" cy="20" r="10" fill="none" stroke="var(--blue)" stroke-width="1.6"></circle>
            <circle cx="25" cy="20" r="10" fill="none" stroke="var(--blue)" stroke-width="1.6"></circle>
            <path d="M15 20 L25 20 L20 11.34 Z" fill="var(--yellow)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round"></path>
            <circle cx="20" cy="11.34" r="2.2" fill="var(--red)"></circle>
          </svg>
          <span>هندسة</span>
        </a>
        <button class="theme-toggle" type="button" aria-label="تبديل الوضع الليلي">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M10 2.5 A7.5 7.5 0 0 1 10 17.5 Z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">شرح تفاعلي مكتوب بأسلوب مستقل، يتبع ترتيب فصول كتاب الهندسة.</div>
    </footer>
  </body>
</html>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line-2);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
  }
  .theme-toggle {
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }
  main {
    min-height: 70vh;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding: 1.5rem 0 2.5rem;
    color: var(--ink-3);
    font-size: 0.9rem;
  }
</style>
