---
// Chapter review page: mixed exercises from all lessons of a chapter,
// with a live score and a list of lessons worth revisiting.
import Base from './Base.astro';
import { chapters, lessonSlug } from '../data/curriculum';
import ChapterGlyph from '../components/ChapterGlyph.astro';
import ChapterRail from '../components/ChapterRail.astro';

interface Props {
  frontmatter: {
    chapter: number;
    intro: string;
  };
}

const { chapter: n, intro } = Astro.props.frontmatter;
const ch = chapters.find((c) => c.n === n)!;
const next = chapters.find((c) => c.n === n + 1);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const last = ch.lessons[ch.lessons.length - 1];
---

<Base title={`مراجعة الفصل ${n}: ${ch.ar} · هندسة`}>
  <div class="wrap page review" data-chapter={n}>
    <header class="lesson-head">
      <nav class="crumbs">
        <a href={`${base}/`}>الفهرس</a>
        <span aria-hidden="true">/</span>
        <span>الفصل {n}: {ch.ar}</span>
      </nav>
      <div class="head-grid">
        <ChapterGlyph n={n} size={84} />
        <div class="titles">
          <h1>مراجعة الفصل {n}</h1>
          <div class="sub">{ch.ar} <span class="en">{ch.en}</span></div>
        </div>
      </div>
      <p class="why"><b>كيف تستخدم هذه الصفحة؟</b> {intro}</p>
    </header>

    <div class="cols">
      <article class="lesson">
        <div class="score" aria-live="polite">
          <div class="score-row">
            <span>حللت <b class="s-solved">0</b> من <b class="s-total">0</b></span>
            <span class="s-first-wrap">من المحاولة الأولى: <b class="s-first">0</b></span>
          </div>
          <div class="bar"><div class="fill"></div></div>
        </div>

        <div class="body">
          <slot />
        </div>

        <section class="summary panel" hidden>
          <h2>النتيجة</h2>
          <p class="sum-text"></p>
          <div class="sum-lessons"></div>
        </section>

        <nav class="pager">
          <a class="pg" href={`${base}/lessons/${lessonSlug(last.id)}/`}>
            <small>السابق</small>
            {last.id} {last.ar}
          </a>
          {
            next && (
              <a class="pg pg-next" href={`${base}/lessons/${lessonSlug(next.lessons[0].id)}/`}>
                <small>الفصل التالي</small>
                {next.lessons[0].id} {next.lessons[0].ar}
              </a>
            )
          }
        </nav>
      </article>

      <aside class="rail">
        <ChapterRail chapter={n} current="review" />
      </aside>
    </div>
  </div>
</Base>

<script>
  const article = document.querySelector<HTMLElement>('.review')!;
  const chapter = article.dataset.chapter!;
  const quizzes = Array.from(article.querySelectorAll<HTMLElement>('quiz-q'));
  const total = quizzes.length;
  const missed = new Set<HTMLElement>();
  const solved = new Set<HTMLElement>();

  const $ = (s: string) => article.querySelector<HTMLElement>(s)!;
  $('.s-total').textContent = String(total);

  function save(first: number) {
    try {
      const all = JSON.parse(localStorage.getItem('review') ?? '{}');
      const prev = all[chapter];
      if (!prev || first > prev.first || (first === prev.first && solved.size > prev.solved))
        all[chapter] = { solved: solved.size, first, total };
      localStorage.setItem('review', JSON.stringify(all));
    } catch {}
  }

  function update() {
    const first = Array.from(solved).filter((q) => !missed.has(q)).length;
    $('.s-solved').textContent = String(solved.size);
    $('.s-first').textContent = String(first);
    $('.fill').style.width = `${(100 * solved.size) / total}%`;
    if (solved.size === total) {
      const sum = $('.summary');
      sum.hidden = false;
      const pct = Math.round((100 * first) / total);
      $('.sum-text').textContent =
        pct >= 90
          ? `ممتاز! أجبت ${first} من ${total} من المحاولة الأولى (${pct}%). أنت جاهز للفصل التالي.`
          : pct >= 70
            ? `جيد جدًا: ${first} من ${total} من المحاولة الأولى (${pct}%). راجع الدروس أدناه لتثبيت ما أخطأت فيه.`
            : `أجبت ${first} من ${total} من المحاولة الأولى (${pct}%). يستحق الأمر مراجعة الدروس أدناه ثم إعادة المحاولة.`;
      const lessons = new Map<string, string>();
      missed.forEach((q) => {
        const a = q.querySelector<HTMLAnchorElement>('.from');
        if (a) lessons.set(a.href, a.textContent!.trim() + ' · ' + (a.title ?? ''));
      });
      $('.sum-lessons').innerHTML = lessons.size
        ? '<p>دروس تستحق المراجعة:</p>' + Array.from(lessons).map(([h, t]) => `<a class="chip" href="${h}">${t}</a>`).join(' ')
        : '';
      save(first);
    }
  }

  article.addEventListener('quiz-missed', (e) => {
    missed.add(e.target as HTMLElement);
    update();
  });
  article.addEventListener('quiz-solved', (e) => {
    solved.add(e.target as HTMLElement);
    update();
  });
  update();
</script>

<style>
  .page {
    padding-top: 1.2rem;
    padding-bottom: 1rem;
  }
  .crumbs {
    font-size: 0.88rem;
    color: var(--ink-3);
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .lesson-head {
    max-width: 46rem;
  }
  .head-grid {
    display: flex;
    gap: 1.1rem;
    align-items: center;
    margin: 1.1rem 0 1.1rem;
  }
  .titles {
    border-inline-start: 1px solid var(--line-2);
    padding-inline-start: 1.1rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 5vw, 2.6rem);
  }
  .sub {
    color: var(--ink-2);
  }
  .sub .en {
    margin-inline-start: 0.4rem;
  }
  .why {
    font-size: 1.08rem;
    color: var(--ink-2);
    margin: 0 0 0.6rem;
  }
  .why b {
    color: var(--ink);
    font-weight: 600;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 46rem) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }
  .rail {
    position: sticky;
    top: 72px;
    padding-top: 1rem;
    max-width: 19rem;
  }
  .score {
    position: sticky;
    top: 62px;
    z-index: 5;
    padding: 0.6rem 0.9rem;
    margin: 0.6rem 0 1rem;
    background: var(--card);
    border: 1px solid var(--line-2);
    border-top: 3px solid var(--ink);
    border-radius: 2px;
  }
  .score-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.95rem;
  }
  .s-first-wrap {
    color: var(--ink-3);
  }
  .bar {
    height: 6px;
    background: var(--paper-2);
    margin-top: 0.45rem;
    overflow: hidden;
  }
  .fill {
    height: 100%;
    width: 0;
    background: var(--good);
    transition: width 0.3s ease;
  }
  .summary {
    margin-top: 1.4rem;
  }
  .summary h2 {
    margin-top: 0;
  }
  .summary :global(.chip) {
    display: inline-block;
    margin: 0.2rem 0 0.2rem 0.3rem;
    font-size: 0.85rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    color: var(--ink);
    background: var(--card);
    text-decoration: none;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .pg {
    display: block;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    padding: 0.7rem 1rem;
    color: var(--ink);
    background: var(--card);
    text-decoration: none;
    line-height: 1.5;
  }
  .pg:hover {
    border-color: var(--ink);
  }
  .pg small {
    display: block;
    color: var(--ink-3);
  }
  .pg-next {
    text-align: left;
    grid-column: 2;
  }
  @media (max-width: 1059px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .rail {
      position: static;
      max-width: none;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line-2);
      margin-top: 1.5rem;
    }
  }
</style>
